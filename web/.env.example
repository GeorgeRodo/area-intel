# Copy to .env.local for local development. On Vercel these are set under
# Project Settings -> Environment Variables instead, and .env.local is never
# deployed (it is gitignored, and .vercelignore does not matter because the file
# is not in the repository at all).
#
# Next.js reads .env.local at server start — restart `npm run dev` after editing.

# ---------------------------------------------------------------------------
# Required: Supabase project
# ---------------------------------------------------------------------------
# Dashboard -> Project Settings -> API Keys.
#
# The publishable key is public by design: it ships inside the browser bundle,
# and RLS is what actually protects the data. NEXT_PUBLIC_SUPABASE_ANON_KEY is
# accepted as an alias everywhere, so either name works — set one.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Required for the Users tab: Supabase service role
# ---------------------------------------------------------------------------
# Settings -> API Keys -> `service_role` (legacy) or `secret`.
#
# Email addresses, password resets and account deletion all live in auth.users,
# which the publishable key cannot touch at all. Without this the routes under
# /api/admin answer 501 and the tab says so.
#
# This key bypasses RLS completely. It has NO NEXT_PUBLIC_ prefix on purpose —
# that prefix is exactly what would inline it into the browser bundle. Never add
# it, never import web/lib/server/admin.js from a component, and on Vercel add
# this as a normal (Sensitive) variable, never a public one.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional: switch the data layer off the demo fixtures
# ---------------------------------------------------------------------------
# Unset (the default) means areas, claims, findings, routines and the wiki
# corpus all come from web/lib/demo.js, and the amber DEMO ribbon says so.
# Accounts and invitations are live on Supabase Auth either way.
#
# Set to 1 only once the database actually has content, or the app shows empty
# areas and zeroed KPIs — which reads as a bug rather than as an empty database:
#
#   python -m kb.seed_grandola     # knowledge_nodes: the verified layer
#   python -m kb.sync_wiki         # wiki_articles:   the research corpus
#
# NEXT_PUBLIC_SUPABASE_DATA=1
